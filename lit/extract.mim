// RUN: rm -rf %t && mkdir -p %t && cd %t && %mim -p mlir %s && %FileCheck %s < %{s:stem}.mlir

plugin tensor;
plugin math;

let F32 = math.F32;

extern fun pick (x: «4, 8; F32», i: Idx 4, j: Idx 8): F32 =
    return ((tensor.buf x)#(i, j));

// CHECK: func.func public @pick(%x: tensor<4x8xf32>, %i: i2, %j: i3) -> f32
// CHECK: arith.index_castui %i
// CHECK: arith.index_castui %j
// CHECK: tensor.extract %x[%{{.*}}, %{{.*}}] : tensor<4x8xf32>
// CHECK: func.return
