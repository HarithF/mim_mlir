// RUN: rm -rf %t && mkdir -p %t && cd %t && %mim -p mlir %s && %FileCheck %s < %{s:stem}.mlir

// The tensor ops whose lowered read maps need real affine arithmetic, rather than "one loop var per output
// position": tensor.conv and tensor.pool read a strided window, tensor.reshape reads a delinearized linear index,
// and a full-rank tensor.broadcast has to shed its size-1 axes before linalg.broadcast will take it.

plugin tensor;
plugin math;

let f32 = math.f32;
let F32 = math.F32;

let R: tensor.Ring = (F32, 0:F32, math.arith.add 0 @f32, math.arith.mul 0 @f32);

let add     = math.arith.add 0 @f32;
let fmax    = math.extrema.fmax 0 @f32;
let neg_inf = 0xFF800000:F32;

// "same" 3x3 conv: stride 1, dilation 1, padding 1 keeps the 4x4 spatial size. The padding becomes a tensor.pad,
// and the windowed multiply-accumulate an affine read map over the 7 conv loops (n, co, oh, ow, ci, kh, kw).
extern fun conv_same (x: «2, 2, 4, 4; F32», w: «3, 2, 3, 3; F32»): «2, 3, 4, 4; F32» =
    return (tensor.conv R ((1, 1), (1, 1), (1, 1)) (tensor.buf x, tensor.buf w));

// 2x2 stride-2 max pool, no padding: 4x4 -> 2x2. The kernel loops (kh, kw) appear only inside the read map's
// arithmetic, so the emitter has to add a shape-only operand to keep them recoverable.
extern fun pool_max (x: «2, 2, 4, 4; F32»): «2, 2, 2, 2; F32» =
    return (tensor.pool (fmax, neg_inf) ((2, 2), (2, 2), (1, 1), (0, 0), (2, 2)) (tensor.buf x));

// Flatten: the read map is a row-major delinearize of the output's linear index.
extern fun flatten (x: «2, 2, 4, 4; F32»): «2, 32; F32» =
    return (tensor.reshape (2, 2, 4, 4) (2, 32) (tensor.buf x));

// Per-channel bias, as the PyTorch importer emits it: reshape the bias to rank 4, then broadcast over NCHW. The
// reshape materializes the size-1 axes, so the broadcast input arrives at full rank.
extern fun bias_nchw (t: «2, 3, 4, 4; F32», bias: «3; F32»): «2, 3, 4, 4; F32» =
    let bias4 = tensor.broadcast ((1, 3, 1, 1), (2, 3, 4, 4), tensor.reshape 3 (1, 3, 1, 1) (tensor.buf bias));
    return (tensor.binary add @(4, (2, 3, 4, 4)) (tensor.buf t, bias4));

// The emitter orders functions by name.
// CHECK-LABEL: func.func public @bias_nchw(%t: tensor<2x3x4x4xf32>, %bias: tensor<3xf32>)
// CHECK: tensor.expand_shape %bias {{.*}} into tensor<1x3x1x1xf32>
// CHECK: affine_map<(d0, d1, d2, d3) -> (0, d1, 0, 0)>
// CHECK: arith.addf

// CHECK-LABEL: func.func public @conv_same(%x: tensor<2x2x4x4xf32>, %w: tensor<3x2x3x3xf32>)
// CHECK: tensor.pad %x low[0, 0, 1, 1] high[0, 0, 1, 1]
// CHECK: linalg.generic
// CHECK-SAME: "reduction", "reduction", "reduction", "reduction"]
// CHECK: arith.mulf
// CHECK: arith.addf
// CHECK: func.return {{.*}} : tensor<2x3x4x4xf32>

// CHECK-LABEL: func.func public @flatten(%x: tensor<2x2x4x4xf32>)
// CHECK: affine_map<(d0, d1) -> (d0, (d1 + d0 * 32) floordiv 16 mod 2, (d1 + d0 * 32) floordiv 4 mod 4, d1 mod 4)>

// CHECK-LABEL: func.func public @pool_max(%x: tensor<2x2x4x4xf32>)
// CHECK: affine_map<(d0, d1, d2, d3, d4, d5) -> (d0, d1, d2 * 2 + d4, d3 * 2 + d5)>
// CHECK-SAME: affine_map<(d0, d1, d2, d3, d4, d5) -> (d4, d5)>
// CHECK: arith.maxnumf
