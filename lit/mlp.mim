// RUN: rm -rf %t && mkdir -p %t && cd %t && %mim -p mlir %s && %FileCheck %s < %{s:stem}.mlir
plugin math;
plugin tensor;

let f32 = %math.f32;
let F32 = %math.F32;
let R: %tensor.Ring = (F32, 0: F32, %math.arith.add @f32 0, %math.arith.mul @f32 0);

lam F32_add {r: Nat, s: «r; Nat»} [is: [«s; F32», «s; F32»]] : «s; F32» =
  %tensor.binary (%math.arith.add @f32 0) is;

lam relu_elem (x: F32) : F32 =
  %math.extrema.ieee754max @f32 0 (0: F32, x);

lam F32_relu {r: Nat, s: «r; Nat»} [i: «s; F32»] : «s; F32» =
  %tensor.unary relu_elem i;

con extern classic_mlp
    [ x:  «4;  «16; F32»»
    , w0: «16; «32; F32»»
    , b0: «32; F32»
    , w1: «32; «8;  F32»»
    , b1: «8;  F32»
    , return: Cn [«4; «8; F32»»]
    ] =
  let h0  = %tensor.product_2d R (x, w0);
  let be0 = %tensor.broadcast ((1, 32), (4, 32), b0);
  let a0  = F32_add @(2, (4, 32)) (h0, be0);
  let r0  = F32_relu @(2, (4, 32)) a0;
  let h1  = %tensor.product_2d R (r0, w1);
  let be1 = %tensor.broadcast ((1, 8), (4, 8), b1);
  let a1  = F32_add @(2, (4, 8)) (h1, be1);
  return a1;


// CHECK: module
// CHECK: func.func public @classic_mlp

// CHECK-DAG: tensor<4x16xf32>
// CHECK-DAG: tensor<16x32xf32>
// CHECK-DAG: tensor<32xf32>
// CHECK-DAG: tensor<32x8xf32>
// CHECK-DAG: tensor<8xf32>

// Final result shape.
// CHECK: tensor<4x8xf32>

