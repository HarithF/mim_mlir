// RUN: rm -rf %t && mkdir -p %t && cd %t && %mim -p mlir %s && %FileCheck %s < %{s:stem}.mlir
plugin core;
plugin mem;

extern fun add(a b: I32): I32 =
    let r = core.wrap.add 0 (a, b);
    return r;

// CHECK: module
// CHECK: func.func public @add(%{{.*}}: i32, %{{.*}}: i32) -> i32
// CHECK: arith.addi
// CHECK: func.return
