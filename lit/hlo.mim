// RUN: rm -rf %t && mkdir -p %t && cd %t && %mim -p mlir %s && %FileCheck %s < %{s:stem}.mlir
plugin math;
plugin tensor;
plugin affine;

let f32 = math.f32;
let F32 = math.F32;

let R: tensor.Ring = (F32, 0:F32, math.arith.add 0 @f32, math.arith.mul 0 @f32);

lam F32_add {r: Nat, s: «r; Nat»} (is: [«s; F32», «s; F32»]): «s; F32» = tensor.binary (math.arith.add 0 @f32) is;
lam F32_tanh {r: Nat, s: «r; Nat»} (i: «s; F32»): «s; F32» = tensor.unary (math.tri.tanh 0 @f32) i;

fun max_fun (acc y: F32)@tt: F32 = return (math.extrema.ieee754max 0 @f32 (acc, y));
lam id1i (i j: affine.Index): «1; affine.Index» = i;
lam id2 (i j: affine.Index): «2; affine.Index» = (i, j);

extern con main_tensor (arg0: «784; «1024; F32»», arg1: «1024; F32», arg2: «1024; «1024; F32»», arg3: «1024; F32», arg4: «1024; «10; F32»», arg5: «10; F32», arg6: «128; «784; F32»», arg7: «128; «10; F32»», return: Cn «128; F32») =
  let v_0 = tensor.product_2d R (tensor.buf arg6, tensor.buf arg0);
  let v_2 = tensor.broadcast ((1, 1024), (128, 1024), tensor.buf arg1);
  let v_3 = F32_add @(2, (128, 1024)) (v_0, v_2);
  let v_4 = F32_tanh @(2, (128, 1024)) v_3;
  let v_7 = tensor.product_2d R (v_4, tensor.buf arg2);
  let v_9 = tensor.broadcast ((1, 1024), (128, 1024), tensor.buf arg3);
  let v_10 = F32_add @(2, (128, 1024)) (v_7, v_9);
  let v_11 = F32_tanh @(2, (128, 1024)) v_10;
  let v_14 = tensor.product_2d R (v_11, tensor.buf arg4);
  let v_16 = tensor.broadcast ((1, 10), (128, 10), tensor.buf arg5);
  let v_17 = F32_add @(2, (128, 10)) (v_14, v_16);
  let v_cst_0 = 0xFEC00000 : F32;

  let v_18 = tensor.map_reduce (128, (128, 10)) (max_fun, v_cst_0) id1i id2 v_17;
  return v_18;

// CHECK: module
// CHECK: func.func public @main_tensor
// CHECK: tensor<784x1024xf32>
// The K dim is strip-mined, so the contraction index is the affine sum `d2 * 4 + d3`.
// CHECK: linalg.generic
// CHECK-SAME: affine_map<(d0, d1, d2, d3) -> (d0, d2 * 4 + d3)>
// CHECK-SAME: iterator_types = ["parallel", "parallel", "reduction", "reduction"]

// `fuse_tensor` folds the bias and the tanh into the `post` slot, so the bias is read by the epilogue's access map
// instead of being materialized by a `linalg.broadcast` first; its size-1 axis collapses out of that map.
// CHECK: linalg.generic
// CHECK-SAME: affine_map<(d0, d1) -> (d1)>
// CHECK: math.tanh

// The row-max writes one element per row, so its write map drops `d1` — unique to the reducing generic.
// CHECK: affine_map<(d0, d1) -> (d0)>
// CHECK: arith.maximumf
// CHECK: func.return {{.*}} tensor<128xf32>
