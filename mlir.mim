/// # The mlir Plugin {#mlir}
///
/// @see mim::plug::mlir
///
/// A minimal mlir emitter plugin
///
///
///## Dependencies

plugin compile;
plugin tensor;

axm %mlir.emit: %compile.Phase;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
      let optimize =
        %compile.phases tt (
            %compile.scalarize,
            %compile.phases tt (
                %compile.beta_red,
                %compile.eta_conv,
            ),
            %compile.named "%mem.seo",
            %compile.static_arg_opt,
        );

        optimize,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %mlir.emit,
    );
