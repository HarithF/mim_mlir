/// # The mlir Plugin {#mlir}
///
/// @see mim::plug::mlir
///
/// A minimal mlir emitter plugin
///
///
///## Dependencies

plugin compile;
plugin tensor;

axm emit: compile.Phase;

extern lam _compile (): compile.Phase =
    let optimize =
        compile.phases tt (
            compile.scalarize,
            compile.phases tt (
                compile.beta_red,
                compile.eta_conv,
            ),
            compile.named "mem.seo",
            compile.static_arg_opt,
        );
    compile.phases ff (
        optimize,
        //compile.named "tensor.reassoc",
        tensor.lower_tensor,
        tensor.fuse_tensor,
        emit,
    );
